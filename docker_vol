Q3. Docker Compose: MySQL with Volume

1. Create docker-compose.yml:
YAML

services:
  db:
    image: mysql:latest
    environment:
      MYSQL_ROOT_PASSWORD: root
      MYSQL_DATABASE: my_db
    volumes:
      - mysql_data:/var/lib/mysql

volumes:
  mysql_data:

2. Verification:
Bash

docker-compose up -d
docker exec -it <container_id> mysql -u root -p
# Inside MySQL: CREATE TABLE test (id INT);
docker-compose restart
docker exec -it <container_id> mysql -u root -p -e "USE my_db; SHOW TABLES;" 




################### Three nginx  ##########################

4. Three Nginx Containers Shared Volume

Note: Because they share the same directory, the last container to write to index.html would usually overwrite the others. To show different content on different ports using one volume, we use command overrides.

1. Create docker-compose.yml:
YAML

services:
  nginx1:
    image: nginx:latest
    ports: ["8081:80"]
    volumes: ["shared-data:/usr/share/nginx/html"]
    command: /bin/sh -c "echo 'Hello from Container 1' > /usr/share/nginx/html/index.html && nginx -g 'daemon off;'"

  nginx2:
    image: nginx:latest
    ports: ["8082:80"]
    volumes: ["shared-data:/usr/share/nginx/html"]
    command: /bin/sh -c "echo 'Hello from Container 2' > /usr/share/nginx/html/index.html && nginx -g 'daemon off;'"

  nginx3:
    image: nginx:latest
    ports: ["8083:80"]
    volumes: ["shared-data:/usr/share/nginx/html"]
    command: /bin/sh -c "echo 'Hello from Container 3' > /usr/share/nginx/html/index.html && nginx -g 'daemon off;'"

volumes:
  shared-data:



docker-compose up -d

